repos:
  - repo: local
    hooks:
      - id: ruff-check
        name: ruff check
        entry: uv run ruff check
        language: system
        types_or: [python, pyi, jupyter]
        require_serial: true
      - id: ruff-format
        name: ruff format
        entry: uv run ruff format
        language: system
        types_or: [python, pyi, jupyter]
        require_serial: true
      - id: ty
        name: ty check
        entry: uv run ty check --quiet
        language: system
        types_or: [python, pyi, jupyter]
        pass_filenames: false
        always_run: true
        require_serial: true
{% if use_dvc %}
      - id: dvc-pushed
        name: DVC data is pushed to remote
        entry: uv run python hooks/check_dvc_pushed.py
        language: system
        files: '(\.dvc|dvc\.lock|dvc\.yaml)$'
        pass_filenames: false
{% endif %}

  - repo: https://github.com/tox-dev/pyproject-fmt
    rev: "b82a24a520c5d496cb7b23b4e9b63537c280f51b" #v2.27.0
    hooks:
      - id: pyproject-fmt
        files: ^pyproject\.toml$
