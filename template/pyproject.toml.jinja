[build-system]
build-backend = "hatchling.build"
requires = [ "hatch-vcs", "hatchling" ]

[project]
name = "{{projectname}}"
description = "{{project_description}}"
requires-python = ">={{python_version}}"
classifiers = [
  "Programming Language :: Python :: 3 :: Only",
{#- Upper bound is one past the newest Python pyproject-fmt knows about; it is pinned in the
    dev group to the same version generated projects pin, and check_render.py fails on drift. -#}
{%- for minor in range(python_version.split(".")[1] | int, 15) %}
  "Programming Language :: Python :: 3.{{ minor }}",
{%- endfor %}
]
dynamic = [ "version" ]
dependencies = []

[tool.hatch]
version.source = "vcs"
build.targets.wheel.packages = [ "src/{{packagename}}" ]

[tool.uv]
required-version = ">=0.13.6"
exclude-newer = "P5D"

[tool.ruff]
lint.select = [
  "B",  # flake8-bugbear
  "E",  # pycodestyle errors
  "F",  # Pyflakes
  "I",  # isort
  "UP", # pyupgrade
  "W",  # pycodestyle warnings
]

[tool.ty]
environment.python-version = "{{ python_version }}"
